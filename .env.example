# Flask (used in later backend phases)
FLASK_ENV=development
FLASK_SECRET_KEY=replace-with-a-secure-random-value
FLASK_CORS_ORIGINS=http://localhost:5173

# Firebase (used in later authentication and Firestore phases)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-service-account-client-email
FIREBASE_PRIVATE_KEY="your-service-account-private-key"
# Optional alternative for local Firebase Admin credentials.
FIREBASE_SERVICE_ACCOUNT_PATH=

# React/Vite (used in later frontend phases)
VITE_API_BASE_URL=http://localhost:5000/api
VITE_FIREBASE_API_KEY=your-public-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_APP_ID=your-firebase-web-app-id
